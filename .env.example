# ---------------------------------------------------------------------------
# Designer Portfolio — environment variables
# Copy to `.env` and fill in real values. `.env` is git-ignored; NEVER commit
# real secrets. Unknown variables fail fast at boot (Zod env parse).
# ---------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). Relative `file:` paths resolve
# from the directory you run commands from (the repo root), so
# `file:./db/custom.db` lives in <repo>/db/ (git-ignored). To use PostgreSQL:
#   1. Set provider = "postgresql" in prisma/schema.prisma
#   2. Set DATABASE_URL to a PostgreSQL connection string
#   3. bun run db:push && bun run db:seed
DATABASE_URL=file:./db/custom.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/designer_portfolio

# ---- Auth -----------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# Required in production; a dev fallback is used only when NODE_ENV=development.
AUTH_SECRET=set-me-openssl-rand-base64-32

# ---- Owner bootstrap (seed) ------------------------------------------------
# The seed creates the OWNER account on first run only; the password is
# ignored afterwards (no default credentials ship in the repo).
# ADMIN_EMAIL defaults to admin@alexmoreau.design
# SEED_ADMIN_PASSWORD must be at least 8 characters.
ADMIN_EMAIL=admin@alexmoreau.design
SEED_ADMIN_PASSWORD=set-me-min-8-chars

# ---- Site ------------------------------------------------------------------
# Canonical public origin — used for metadata, sitemap.xml, and robots.txt.
# Set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional integrations --------------------------------------------------
# Google OAuth (login page shows an honest "not configured" notice until set).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP for inquiry notification emails (log-to-console transport when unset).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hello@alexmoreau.design

# ---- E2E tests (Playwright) --------------------------------------------------
# The suite runs against an existing server by default (http://127.0.0.1:3000).
#   E2E_ADMIN_EMAIL     — account the auth/dashboard specs sign in as
#                         (defaults to ADMIN_EMAIL)
#   E2E_ADMIN_PASSWORD  — its password; auth/dashboard/inquiry specs SKIP
#                         themselves when unset
#   E2E_START=1         — let Playwright manage the server itself
#   E2E_COMMAND         — server command for E2E_START (default "bun run dev");
#                         use "bun run start" after `bun run build`
#   E2E_PORT / E2E_BASE_URL — override the target origin
#   E2E_OUTAGE=1        — enable the 5 graceful-degradation specs
#                         (e2e/outage.spec.ts); pair with an
#                         E2E_COMMAND whose DATABASE_URL points at an
#                         unwritable path, e.g.
#                         E2E_COMMAND="PORT=3100 DATABASE_URL=file:./db-outage-missing/custom.db bun run start"
# TIP: on hosts with < ~6 GB RAM, run the suite against the production server
# (bun run build && E2E_START=1 E2E_COMMAND="bun run start" bunx playwright test)
# — the Turbopack dev server + Chromium can exceed the memory budget.
E2E_ADMIN_EMAIL=admin@alexmoreau.design
E2E_ADMIN_PASSWORD=
